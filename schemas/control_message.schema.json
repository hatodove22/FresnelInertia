{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/control_message.schema.json",
  "title": "ControlMessage",
  "type": "object",
  "required": ["type", "timestamp_ms"],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "set_param",
        "load_preset",
        "set_run_mode",
        "start_calibration",
        "stop_calibration",
        "request_telemetry",
        "set_tilt_mode",
        "record_start",
        "record_stop",
        "replay_start",
        "replay_stop"
      ]
    },
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "preset": {"type": "string"},
    "path": {"type": "string"},
    "value": {},
    "run_mode": {
      "type": "string",
      "enum": ["idle", "live", "calibration", "record", "replay"]
    },
    "payload": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "file": {"type": "string"},
        "path": {"type": "string"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
